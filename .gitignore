# ==============================================================================
# EduFee Pro — Comprehensive Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Agents, Assistants & Internal Tooling (Excluded from Production Codebase)
# ------------------------------------------------------------------------------
.agent/
.agents/
.gemini/
.gsd/
adapters/
scratch/
scripts/
Resource/
GSD-STYLE.md
PROJECT_RULES.md
VERSION
model_capabilities.yaml

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ------------------------------------------------------------------------------
# 3. Python & Django Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Django Databases & Live Operational Data
*.sqlite3
*.db
backend/db.sqlite3
db.sqlite3-journal

# Django User Uploads (Media) - Preserve directory structure only
backend/media/*
!backend/media/.gitkeep
!backend/media/payments/
backend/media/payments/*
!backend/media/payments/.gitkeep

# Django Collected Static Files & Logs
backend/staticfiles/
backend/static_collected/
*.log
local_settings.py

# ------------------------------------------------------------------------------
# 4. Node & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlint-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. OS & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
*.temp
