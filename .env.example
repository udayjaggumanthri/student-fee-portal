# ==============================================================================
# EduFee Pro — Unified Project Environment Configuration Example
# Copy this file to '.env' at the repository root for monorepo or container setups.
# ==============================================================================

# Backend Django Configuration
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-super-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-production-domain.com

# Backend CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.com

# Frontend Configuration
VITE_API_URL=/api
VITE_APP_NAME="EduFee Pro"

# Optional Database URL (PostgreSQL for Production)
# DATABASE_URL=postgres://user:password@localhost:5432/edufee_db
