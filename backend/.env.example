# ==============================================================================
# EduFee Pro — Backend Environment Configuration Example
# Copy this file to '.env' and populate with your production or local secrets.
# ==============================================================================

# Core Django Security Settings
# Generate a cryptographically secure key for production:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-robust-production-secret-key-min-50-chars

# Set to False in production!
DJANGO_DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,edufee.yourdomain.com

# CORS Configuration
# Allow frontend origins to communicate with the REST API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://edufee.yourdomain.com

# Database Configuration (Defaults to SQLite at backend/db.sqlite3 if omitted)
# For production PostgreSQL:
# DATABASE_URL=postgres://edufee_user:securepassword@localhost:5432/edufee_pro

# Static and Media Assets
# Path where collectstatic will collect static files for deployment
STATIC_ROOT=staticfiles/
MEDIA_ROOT=media/

# Optional Outbound SMTP Email Settings (Can also be managed via Admin Settings UI)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=notifications@yourdomain.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=EduFee Pro <notifications@yourdomain.com>
