# ==============================================================================
# EduFee Pro — Frontend Environment Configuration Example
# Copy this file to '.env' or '.env.local' to customize frontend behavior.
# ==============================================================================

# API Base URL
# - In local development: leave as /api to leverage Vite's reverse proxy (avoids CORS)
# - In split production (API on a separate domain): set to full API prefix, e.g. https://api.yourdomain.com/api
VITE_API_URL=/api

# Application Branding & Metadata
VITE_APP_NAME="EduFee Pro"
VITE_APP_VERSION="1.0.0"
